# Copie para .env e preencha só se for usar o modelo.
# Sem chave, o Nexo Assist decide pelas regras do service desk.

AGENT_MODE=auto
MASTRA_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# 0 desliga a falha ocasional do legado. 0.05 é o padrão da aplicação.
TICKET_FLAKY=0.05

# Só para testes locais. Não ligue em produção.
ALLOW_RESET=0

# Opcional. O padrão é ./data/nexo.sqlite
# NEXO_DB=./data/nexo.sqlite
